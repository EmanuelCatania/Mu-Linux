MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=MuOnline97
MYSQL_USER=mu_admin
MYSQL_PASSWORD=changeme_pass

DB_HOST=mysql
DB_PORT=3306
DB_USER=mu_admin
DB_PASS=changeme_pass
DB_NAME=MuOnline97
PUBLIC_IP=
# 1 = el GameServer deja disponible la traza de paquetes (leer con:
# docker compose exec mu-server mu-trace tail). Sin lector no copia nada.
MU_TRACE_ENABLED=0
# 1 = además graba la traza en GameServer/LOG/trace, con tope de MU_TRACE_KEEP_MB.
# Se lee con: docker compose exec mu-server mu-trace read /opt/mu/GameServer/LOG/trace
MU_TRACE_RECORD=0
MU_TRACE_KEEP_MB=1024
# 1 = el server publica los parches del launcher desde Data/Patches y mu-web los
# sirve en /updates/ (docs/parches-del-launcher.md).
MU_UPDATE_ENABLED=0
MU_UPDATE_CHANNEL=mi-server/overlay
MU_UPDATE_INTERVAL=30
# URL pública donde se ve /updates/ de mu-web (varias separadas por coma, como
# espejos).  Va en launcher.json: el launcher la aprende del ConnectServer.
MU_UPDATE_URL=
# Direcciones del ConnectServer que aprende el launcher (host:puerto, separadas
# por coma).  Vacío: PUBLIC_IP:44405.
MU_LAUNCHER_CONNECT_SERVERS=
# Texto que muestra el launcher ("\n" para cortar la línea).
MU_LAUNCHER_NEWS=
# Sitio del server: el launcher lo abre desde Opciones > General.
MU_LAUNCHER_WEB_URL=
# 1: el cliente de escritorio sólo se juega desde el launcher (abierto directo,
# abre el launcher y se cierra).  La versión web no lo aplica.
MU_LAUNCHER_REQUIRED=0
# MU-Guard (docs/mu-guard.md): 1 levanta mu-guard (puerto 55980/tcp, hay que
# abrirlo) y el cliente se abre con su guardián.  MU_GUARD_REQUIRED=1 además
# rechaza el login de un cliente sin guardián (sólo escritorio; la web no lo
# tiene todavía).
MU_GUARD_ENABLED=0
MU_GUARD_REQUIRED=0
# Origen de la base para el launcher (vacío: el compilado en el launcher).
MU_LAUNCHER_BASE_SOURCE=
MU_LAUNCHER_BASE_TAG=
MU_LAUNCHER_BASE_KEY=
UPDATES_RATE_LIMIT_PER_MINUTE=120

WEB_PORT=8080
SESSION_SECRET=change-this-secret
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
INSTALL_GEOIP=0
GEOIP_ENABLED=0
GEOIP_HIDDEN_COUNTRIES=
ACQUISITION_TRACKING=0
RANKINGS_RESETS_FIRST=0
ADMIN_USER=admin
ADMIN_PASS=123456
TRUST_PROXY=1
SEED_TEST_DATA=0
TZ=America/Argentina/Buenos_Aires
TIMEZONE=America/Argentina/Buenos_Aires
EDITOR_ENABLED=0
EDITOR_PORT=8090
EDITOR_MAX_BACKUPS=5
EDITOR_API_URL=http://mu-editor:8090
EDITOR_MAX_SNAPSHOTS=5
